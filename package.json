{
  "name": "jumpyard-check-in",
  "version": "0.1.0",
  "private": true,
  "description": "JumpYard Check-in repository workflow and validation scripts.",
  "scripts": {
    "validate": "npm run validate:template && npm run validate:current-ticket && npm run validate:followups && npm run validate:history-archives && npm run validate:skills && npm run validate:aws && npm run validate:park-test-frontend-target && npm run validate:t0177-contact-lookup && npm run validate:t0190-safety-gates && npm run validate:t0192-request-item-dates && npm run validate:t0193-capacity && npm run validate:t0193-guest-access && npm run validate:t0193-payload-limits && npm run validate:t0193-service-auth && npm run validate:t0194-staff-identity-backend && npm run validate:t0194-staff-identity-frontend && npm run validate:t0194-staff-identity-infra && npm run validate:t0194-staff-identity-ops",
    "validate:template": "node scripts/validate-template.js",
    "validate:current-ticket": "node scripts/validate-current-ticket.js",
    "validate:followups": "node scripts/validate-followups.js",
    "validate:history-archives": "node scripts/validate-history-archives.js",
    "validate:skills": "node scripts/validate-skills.js",
    "validate:aws": "node scripts/validate-aws-tags.js",
    "validate:park-test-frontend-target": "node scripts/validate-park-test-frontend-target.js",
    "validate:t0177-contact-lookup": "node scripts/validate-t0177-contact-lookup.js",
    "validate:t0190-safety-gates": "node scripts/validate-t0190-safety-gates.js",
    "validate:t0192-request-item-dates": "node scripts/validate-t0192-request-item-dates.js",
    "validate:t0193-capacity": "node scripts/validate-t0193-capacity.js",
    "validate:t0193-guest-access": "node scripts/validate-t0193-guest-access.js",
    "validate:t0193-payload-limits": "node scripts/validate-t0193-payload-limits.js",
    "validate:t0193-service-auth": "node scripts/validate-t0193-service-auth.js",
    "validate:t0194-staff-identity-backend": "node scripts/validate-t0194-staff-identity-backend.js",
    "validate:t0194-staff-identity-frontend": "node scripts/validate-t0194-staff-identity-frontend.js",
    "validate:t0194-staff-identity-infra": "node scripts/validate-t0194-staff-identity-infra.js",
    "validate:t0194-staff-identity-ops": "npm --prefix infra run validate:t0194-staff-identity-ops",
    "infra:check": "npm --prefix infra run check",
    "infra:synth": "npm --prefix infra run synth:example",
    "roller:env:check": "node scripts/check-roller-env.js",
    "roller:smoke": "node scripts/roller-smoke.js",
    "roller:data:smoke": "node scripts/roller-data-api-smoke.js",
    "roller:payment:discover": "node scripts/roller-payment-discovery.js",
    "roller:payment:discover:apply-draft": "node scripts/roller-payment-discovery.js --apply-draft",
    "roller:payment:readiness": "node scripts/roller-payment-readiness.js",
    "roller:payment:poc": "node scripts/roller-payment-package-poc.js",
    "roller:payment:poc:apply-draft": "node scripts/roller-payment-package-poc.js --apply-draft",
    "roller:seed:playground": "node scripts/roller-seed-playground.js",
    "roller:seed:playground:apply": "node scripts/roller-seed-playground.js --apply"
  }
}

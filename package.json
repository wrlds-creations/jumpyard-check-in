{
  "name": "jumpyard-check-in",
  "version": "0.1.0",
  "private": true,
  "description": "JumpYard Check-in repository workflow and validation scripts.",
  "scripts": {
    "validate": "npm run validate:template && npm run validate:current-ticket && npm run validate:skills && npm run validate:aws",
    "validate:template": "node scripts/validate-template.js",
    "validate:current-ticket": "node scripts/validate-current-ticket.js",
    "validate:skills": "node scripts/validate-skills.js",
    "validate:aws": "node scripts/validate-aws-tags.js",
    "infra:check": "npm --prefix infra run check",
    "infra:synth": "npm --prefix infra run synth:example",
    "roller:env:check": "node scripts/check-roller-env.js",
    "roller:smoke": "node scripts/roller-smoke.js",
    "roller:data:smoke": "node scripts/roller-data-api-smoke.js",
    "roller:payment:discover": "node scripts/roller-payment-discovery.js",
    "roller:payment:discover:apply-draft": "node scripts/roller-payment-discovery.js --apply-draft",
    "roller:payment:readiness": "node scripts/roller-payment-readiness.js",
    "roller:payment:poc": "node scripts/roller-payment-package-poc.js",
    "roller:payment:poc:apply-draft": "node scripts/roller-payment-package-poc.js --apply-draft",
    "roller:seed:playground": "node scripts/roller-seed-playground.js",
    "roller:seed:playground:apply": "node scripts/roller-seed-playground.js --apply"
  }
}

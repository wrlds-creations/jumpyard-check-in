{
  "name": "jumpyard-checkin-phone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:tunnel": "concurrently \"next dev\" \"npx cloudflared tunnel --url http://localhost:3000\"",
    "build": "next build",
    "test:product-visibility": "node --experimental-default-type=module --experimental-strip-types --test src/flow/productVisibility.test.mjs",
    "test:exit-flow": "node --no-warnings --experimental-strip-types --test src/flow/exitFlowPolicy.test.mjs",
    "test:addon-back": "node --no-warnings --experimental-strip-types --test src/flow/addonPaymentNavigation.test.mjs",
    "test:payment-confirmation": "node --no-warnings --test src/flow/phonePaymentConfirmation.test.mjs src/app/preview/payment/PhonePaymentPreview.test.mjs",
    "test:payment-recovery": "node --no-warnings --experimental-strip-types --test src/flow/paymentRecovery.test.mjs src/flow/phonePaymentRecovery.test.mjs src/flow/googlePaySubmissionRecovery.test.mjs src/flow/buyTicketsPaymentRecovery.test.mjs src/flow/pagePaymentRecovery.test.mjs src/flow/completedPurchaseRecovery.test.mjs src/flow/completedBookingView.test.mjs",
    "test:paid-confirmation": "node --no-warnings --experimental-strip-types --test src/flow/paidBookingConfirmation.test.mjs",
    "test:language-toggle": "node --no-warnings --test src/flow/languageToggle.test.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@roller/ecom-payments": "file:vendor/ecom-payments",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.559.0",
    "next": "16.0.8",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

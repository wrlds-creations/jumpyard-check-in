{
  "name": "jumpyard-cloud-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK foundation for JumpYard Cloud.",
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "cdk synth",
    "synth:example": "cdk synth -c config=./config/dev.example.json",
    "synth:dev": "cdk synth -c config=./config/dev.json",
    "synth:park-test": "cdk synth -c config=./config/park-test.json",
    "synth:park-test-addon-smoke": "cdk synth -c config=./config/park-test-live-addon-smoke.json",
    "synth:park-test-addon-settlement-smoke": "cdk synth -c config=./config/park-test-live-addon-settlement-smoke.json",
    "synth:park-test-assisted-lookup": "cdk synth -c config=./config/park-test-assisted-lookup.json",
    "synth:park-test-lookup-smoke": "cdk synth -c config=./config/park-test-live-lookup-smoke.json",
    "synth:park-test-payment-smoke": "cdk synth -c config=./config/park-test-live-payment-smoke.json",
    "synth:park-test-payment-sync-smoke": "cdk synth -c config=./config/park-test-live-payment-sync-smoke.json",
    "synth:park-test-redeem-smoke": "cdk synth -c config=./config/park-test-live-redeem-smoke.json",
    "synth:park-test-frontend-redeem-rehearsal": "cdk synth -c config=./config/park-test-frontend-redeem-rehearsal.json",
    "synth:park-test-full-flow-rehearsal": "cdk synth -c config=./config/park-test-full-flow-rehearsal.json",
    "diff:dev": "cdk diff -c config=./config/dev.json --profile wrlds-dev",
    "diff:park-test-addon-smoke": "cdk diff -c config=./config/park-test-live-addon-smoke.json --profile wrlds-dev",
    "diff:park-test-addon-settlement-smoke": "cdk diff -c config=./config/park-test-live-addon-settlement-smoke.json --profile wrlds-dev",
    "diff:park-test-assisted-lookup": "cdk diff -c config=./config/park-test-assisted-lookup.json --profile wrlds-dev",
    "diff:park-test-lookup-smoke": "cdk diff -c config=./config/park-test-live-lookup-smoke.json --profile wrlds-dev",
    "diff:park-test-payment-smoke": "cdk diff -c config=./config/park-test-live-payment-smoke.json --profile wrlds-dev",
    "diff:park-test-payment-sync-smoke": "cdk diff -c config=./config/park-test-live-payment-sync-smoke.json --profile wrlds-dev",
    "diff:park-test-redeem-smoke": "cdk diff -c config=./config/park-test-live-redeem-smoke.json --profile wrlds-dev",
    "diff:park-test-frontend-redeem-rehearsal": "cdk diff -c config=./config/park-test-frontend-redeem-rehearsal.json --profile wrlds-dev",
    "diff:park-test-full-flow-rehearsal": "cdk diff -c config=./config/park-test-full-flow-rehearsal.json --profile wrlds-dev",
    "deploy:dev": "cdk deploy -c config=./config/dev.json --profile wrlds-dev --require-approval never",
    "deploy:park-test": "cdk deploy -c config=./config/park-test.json --profile wrlds-dev --require-approval never",
    "deploy:park-test-addon-smoke": "cdk deploy -c config=./config/park-test-live-addon-smoke.json --profile wrlds-dev --require-approval never",
    "deploy:park-test-addon-settlement-smoke": "cdk deploy -c config=./config/park-test-live-addon-settlement-smoke.json --profile wrlds-dev --require-approval never",
    "deploy:park-test-assisted-lookup": "cdk deploy -c config=./config/park-test-assisted-lookup.json --profile wrlds-dev --require-approval never",
    "deploy:park-test-lookup-smoke": "cdk deploy -c config=./config/park-test-live-lookup-smoke.json --profile wrlds-dev --require-approval never",
    "deploy:park-test-payment-smoke": "cdk deploy -c config=./config/park-test-live-payment-smoke.json --profile wrlds-dev --require-approval never",
    "deploy:park-test-payment-sync-smoke": "cdk deploy -c config=./config/park-test-live-payment-sync-smoke.json --profile wrlds-dev --require-approval never",
    "deploy:park-test-redeem-smoke": "cdk deploy -c config=./config/park-test-live-redeem-smoke.json --profile wrlds-dev --require-approval never",
    "deploy:park-test-frontend-redeem-rehearsal": "cdk deploy -c config=./config/park-test-frontend-redeem-rehearsal.json --profile wrlds-dev --require-approval never",
    "deploy:park-test-full-flow-rehearsal": "cdk deploy -c config=./config/park-test-full-flow-rehearsal.json --profile wrlds-dev --require-approval never",
    "migrate:dev": "ts-node --prefer-ts-exts scripts/run-migrations.ts --config ./config/dev.json --profile wrlds-dev",
    "migrate:dev:status": "ts-node --prefer-ts-exts scripts/run-migrations.ts --config ./config/dev.json --profile wrlds-dev --status",
    "import:bookingitems:dev": "ts-node --prefer-ts-exts scripts/import-bookingitems.ts --config ./config/dev.json --profile wrlds-dev",
    "import:bookingitems:dev:apply": "ts-node --prefer-ts-exts scripts/import-bookingitems.ts --config ./config/dev.json --profile wrlds-dev --apply",
    "import:products:dev": "ts-node --prefer-ts-exts scripts/import-products.ts --config ./config/dev.json --profile wrlds-dev",
    "import:products:dev:apply": "ts-node --prefer-ts-exts scripts/import-products.ts --config ./config/dev.json --profile wrlds-dev --apply",
    "import:related-data:dev": "ts-node --prefer-ts-exts scripts/import-related-data.ts --config ./config/dev.json --profile wrlds-dev",
    "import:related-data:dev:apply": "ts-node --prefer-ts-exts scripts/import-related-data.ts --config ./config/dev.json --profile wrlds-dev --apply",
    "import:data-api-backfill:dev": "ts-node --prefer-ts-exts scripts/import-data-api-backfill.ts --config ./config/dev.json --profile wrlds-dev",
    "import:data-api-backfill:dev:apply": "ts-node --prefer-ts-exts scripts/import-data-api-backfill.ts --config ./config/dev.json --profile wrlds-dev --apply",
    "register:webhook:dev": "ts-node --prefer-ts-exts scripts/register-roller-webhook.ts --config ./config/dev.json --profile wrlds-dev",
    "register:webhook:dev:apply": "ts-node --prefer-ts-exts scripts/register-roller-webhook.ts --config ./config/dev.json --profile wrlds-dev --apply",
    "register:webhook:live:park-test": "ts-node --prefer-ts-exts scripts/roller-live-webhook-register.ts --config ./config/park-test.json --profile wrlds-dev",
    "register:webhook:live:park-test:apply": "ts-node --prefer-ts-exts scripts/roller-live-webhook-register.ts --config ./config/park-test.json --profile wrlds-dev --apply",
    "webhook:live:park-test:dry-run": "ts-node --prefer-ts-exts scripts/roller-live-webhook-dry-run.ts --config ./config/park-test.json --profile wrlds-dev",
    "catalog:index:live:park-test": "ts-node --prefer-ts-exts scripts/roller-live-catalog-index-readiness.ts --config ./config/park-test.json --profile wrlds-dev",
    "contact:live:park-test": "ts-node --prefer-ts-exts scripts/roller-live-contact-resolver.ts --config ./config/park-test.json --profile wrlds-dev",
    "quote:live:park-test": "ts-node --prefer-ts-exts scripts/roller-live-quote-smoke.ts --config ./config/park-test.json --profile wrlds-dev",
    "draft:live:park-test": "ts-node --prefer-ts-exts scripts/roller-live-draft-smoke.ts --config ./config/park-test.json --profile wrlds-dev",
    "preflight:roller-live:park-test": "ts-node --prefer-ts-exts scripts/roller-live-readonly-preflight.ts --config ./config/park-test.json --profile wrlds-dev",
    "validate:config-guards": "ts-node --prefer-ts-exts scripts/validate-config-guards.ts",
    "validate:park-test-synth": "ts-node --prefer-ts-exts scripts/validate-park-test-synth.ts",
    "validate:t0190-safety-gates": "node ../scripts/validate-t0190-safety-gates.js",
    "validate:roller-live-contact-resolver": "ts-node --prefer-ts-exts scripts/roller-live-contact-resolver.ts --self-test",
    "validate:roller-live-readonly-preflight": "ts-node --prefer-ts-exts scripts/roller-live-readonly-preflight.ts --self-test",
    "validate:roller-live-catalog-index-readiness": "ts-node --prefer-ts-exts scripts/roller-live-catalog-index-readiness.ts --self-test",
    "validate:roller-live-webhook-dry-run": "ts-node --prefer-ts-exts scripts/roller-live-webhook-dry-run.ts --self-test",
    "validate:roller-live-webhook-register": "ts-node --prefer-ts-exts scripts/roller-live-webhook-register.ts --self-test",
    "validate:roller-live-quote-smoke": "ts-node --prefer-ts-exts scripts/roller-live-quote-smoke.ts --self-test",
    "validate:roller-live-draft-smoke": "ts-node --prefer-ts-exts scripts/roller-live-draft-smoke.ts --self-test",
    "check": "npm run build && npm run validate:config-guards && npm run validate:park-test-synth && npm run validate:t0190-safety-gates && npm run validate:roller-live-readonly-preflight && npm run validate:roller-live-catalog-index-readiness && npm run validate:roller-live-contact-resolver && npm run validate:roller-live-webhook-dry-run && npm run validate:roller-live-webhook-register && npm run validate:roller-live-quote-smoke && npm run validate:roller-live-draft-smoke && npm run synth:example"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "^3.1050.0",
    "@aws-sdk/client-secrets-manager": "^3.1050.0",
    "@aws-sdk/client-ssm": "^3.1050.0",
    "@aws-sdk/credential-providers": "^3.1050.0",
    "aws-cdk-lib": "^2.175.1",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "aws-cdk": "^2.175.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}

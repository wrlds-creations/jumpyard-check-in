ROLLER_ENV=playground
ROLLER_BASE_URL=
ROLLER_CLIENT_ID=
ROLLER_CLIENT_SECRET=

# Optional T0008 seed-tool controls.
# Keep blank for normal dry-run planning. Required only with --apply.
ROLLER_SEED_ALLOW_WRITE=
ROLLER_SEED_DATE=
ROLLER_SEED_WRITE_ENDPOINT=/bookings

# Optional T0011 Data API smoke controls.
# Defaults to /data/bookingitems and today's modified-date window.
ROLLER_DATA_API_PATH=/data/bookingitems
ROLLER_DATA_START_DATE=
ROLLER_DATA_END_DATE=
ROLLER_DATA_PAGE_SIZE=100
ROLLER_DATA_MAX_PAGES=3

# Optional T0012 dev Aurora bookingitems import controls.
# Required only when running the apply command that writes to dev Aurora.
JUMPYARD_VENUE_ID=jumpyard-check-in-dev
ROLLER_IMPORT_ALLOW_WRITE=

# Phone/admin app public dev API config. Safe to expose; no secrets belong here.
NEXT_PUBLIC_JUMPYARD_CLOUD_API_BASE_URL=https://m0uo5g4mde.execute-api.eu-north-1.amazonaws.com
NEXT_PUBLIC_JUMPYARD_LOOKUP_EXPECTED_DATE=2026-05-21

# Optional T0032 payment package proof-of-concept controls.
# The POC calls JumpYard Cloud quote/draft endpoints, not Roller directly.
JUMPYARD_CLOUD_API_BASE_URL=https://m0uo5g4mde.execute-api.eu-north-1.amazonaws.com
ROLLER_PAYMENT_POC_PRODUCT_ID=1765836
ROLLER_PAYMENT_POC_BOOKING_DATE=
ROLLER_PAYMENT_POC_START_TIME=10:00
ROLLER_PAYMENT_POC_QUANTITY=1
ROLLER_PAYMENT_POC_ALLOW_DRAFT=
ROLLER_PAYMENT_PACKAGE_URL=
ROLLER_PAYMENT_PACKAGE_DOCS_URL=https://docs.roller.app/docs/roller-payments/egj77d29eagwv-version-history
ROLLER_PAYMENT_PUBLIC_ORIGIN=https://jumpyard-check-in.pages.dev
ROLLER_PAYMENT_ALLOWLIST_CONFIRMED=false
ROLLER_PAYMENT_TEST_CARD_LAST4=1142
ROLLER_PAYMENT_TEST_CARD_CONFIRMED=false
